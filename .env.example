# Copy this file to .env and fill in your values.
# These env vars override config.yaml settings.

# ─── Database ────────────────────────────────────────────────────────
# SQLite (default)
# DATABASE_URL=sqlite:///data/finishline.db

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/finishline

# ─── YOLO ────────────────────────────────────────────────────────────
# FINISHLINE_YOLO_MODEL=yolov8n.pt
# FINISHLINE_YOLO_CONFIDENCE=0.40
# FINISHLINE_YOLO_IOU=0.45
# FINISHLINE_YOLO_DEVICE=         # blank = auto (CPU); use "cuda:0" for GPU

# ─── Crossing ────────────────────────────────────────────────────────
# FINISHLINE_CROSSING_COOLDOWN_SECONDS=2.0

# ─── Burst capture ───────────────────────────────────────────────────
# FINISHLINE_BURST_FRAMES_BEFORE=10
# FINISHLINE_BURST_FRAMES_AFTER=10

# ─── OCR ─────────────────────────────────────────────────────────────
# FINISHLINE_OCR_ENGINE=paddleocr     # paddleocr | easyocr
# FINISHLINE_OCR_CONFIDENCE_THRESHOLD=0.55
# FINISHLINE_OCR_ZOOM_SCALE=2.0
# FINISHLINE_OCR_MAX_DIGITS=3

# ─── Output ──────────────────────────────────────────────────────────
# FINISHLINE_OUTPUT_BASE_DIR=data/outputs

# ─── Config file path (optional) ─────────────────────────────────────
# FINISHLINE_CONFIG=config.yaml
